# Copy to .env and fill in. Never commit the real .env.

# Database password: letters and digits only (it goes into a URL), e.g. `openssl rand -hex 24`.
POSTGRES_PASSWORD=

# Who can reach the app: 127.0.0.1 (this computer, for an HTTPS proxy or tunnel in front)
# or 0.0.0.0 (also your home network, as http://<this computer>:8009).
BUDGET_BIND=127.0.0.1

# Who may join: `invite` (people the owner sends a link) or `open` (anyone can create a budget
# of their own on the sign-in page).
BUDGET_SIGNUP=invite

# Optional: open the budget inside Telegram too. A bot token from @BotFather.
TELEGRAM_BOT_TOKEN=

# Optional, defaults shown:
# BUDGET_PORT=8009                      # the port on that address
# BUDGET_SESSION_TTL_SECONDS=2592000    # a sign-in lasts 30 days
# BUDGET_SESSION_COOKIE_SECURE=auto     # true / false to force; auto follows the proxy's X-Forwarded-Proto
# BUDGET_MAX_ACTIVE_SESSIONS_PER_USER=5
# OWNER_TELEGRAM_ID=                    # Telegram only: who may become the owner by signing in with Telegram
# RUST_LOG=info
# Support the author (Settings → Support the author). Left out: the author's own addresses
# are shown. Set empty to hide a way, e.g. BUDGET_DONATE_TON=
# BUDGET_DONATE_TON=
# BUDGET_DONATE_GITHUB=
# BUDGET_DONATE_URL=
# BUDGET_SOURCE_URL=                    # only for a modified copy: where its source code is
